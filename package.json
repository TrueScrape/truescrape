{
  "name": "truescrape",
  "version": "0.5.1",
  "description": "Social media data API and MCP server: Instagram, TikTok, YouTube, X, Facebook, LinkedIn, Reddit and more, as JSON from the terminal or as tools for Claude, Cursor and other AI agents. 1,000 free credits.",
  "mcpName": "io.github.TrueScrape/truescrape",
  "type": "module",
  "bin": {
    "truescrape": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalogue": "tsx scripts/catalogue.ts",
    "hygiene": "tsx scripts/hygiene.ts",
    "prepublishOnly": "pnpm build && pnpm test && pnpm hygiene"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueScrape/truescrape.git"
  },
  "homepage": "https://truescrape.com",
  "bugs": "https://github.com/TrueScrape/truescrape/issues",
  "keywords": [
    "truescrape",
    "social-media",
    "scraping",
    "api",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "claude",
    "cursor",
    "agent-skill",
    "web-scraping",
    "scraper",
    "social-media-api",
    "instagram",
    "instagram-scraper",
    "tiktok",
    "tiktok-scraper",
    "youtube",
    "youtube-transcript",
    "twitter",
    "facebook",
    "linkedin",
    "reddit",
    "threads"
  ],
  "license": "MIT",
  "author": "TrueScrape",
  "packageManager": "pnpm@11.5.3"
}
