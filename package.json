{
  "name": "truescrape",
  "version": "0.1.0",
  "description": "CLI for the TrueScrape API: public social media data from every platform in the catalogue, from the terminal or as an MCP server for agents.",
  "type": "module",
  "bin": {
    "truescrape": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "catalogue": "tsx scripts/catalogue.ts",
    "hygiene": "tsx scripts/hygiene.ts",
    "prepublishOnly": "pnpm build && pnpm test && pnpm hygiene"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TrueScrape/truescrape.git"
  },
  "homepage": "https://truescrape.com",
  "bugs": "https://github.com/TrueScrape/truescrape/issues",
  "keywords": [
    "truescrape",
    "social-media",
    "scraping",
    "api",
    "cli",
    "mcp",
    "youtube",
    "tiktok",
    "instagram",
    "agent-skill"
  ],
  "license": "MIT",
  "author": "TrueScrape",
  "packageManager": "pnpm@11.5.3"
}
